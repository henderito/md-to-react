if [ "$CI" = "true" ] || [ -n "$CI" ]; then
  exit 0
fi

if [ -n "$2" ] && [ "$2" != "message" ]; then
  exit 0
fi

# Check if message already contains a bump tag
if grep -qE '\[patch\]|\[minor\]|\[major\]' "$1"; then
  exit 0
fi

# Reattach TTY for interactive prompt
exec < /dev/tty

echo "Does this commit contain a version bump? (y/n) [n]: "
read -r answer
if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
  echo "Which type? (p)atch, (m)inor, (M)ajor: "
  read -r type_answer
  case "$type_answer" in
    p|P|patch) tag="[patch]" ;;
    m|minor) tag="[minor]" ;;
    M|major) tag="[major]" ;;
    *) echo "Invalid choice. No tag appended."; exit 0 ;;
  esac
  
  # Append tag to the first line of the commit message
  awk -v tag="$tag" 'NR==1 {print $0 " " tag} NR>1 {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
fi
